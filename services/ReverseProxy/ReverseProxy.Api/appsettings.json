{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "legacy-route": {
        "ClusterId": "legacy-cluster",
        "Match": {
          "Path": "{**catch-all}"
        }
      },
      "catalog-items-read": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/catalog-items/{**rest}",
          "Methods": [ "GET" ]
        }
      },
      "catalog-brands-read": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/catalog-brands",
          "Methods": [ "GET" ]
        }
      },
      "catalog-types-read": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/catalog-types",
          "Methods": [ "GET" ]
        }
      }
    }
  }
}
