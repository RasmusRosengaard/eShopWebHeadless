<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData"
                                DefaultLayout="@typeof(ShopLayout)">
                <NotAuthorized>
                    @if (!context.User.Identity.IsAuthenticated)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <div class="container">
                            <h2>Not Authorized</h2>
                            <p>You are not authorized to access this resource. <a href="">Return to eShop</a></p>
                        </div>
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(ShopLayout)">
                <div class="container"><p>Sorry, there's nothing at this address.</p></div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
