<div class="esh-pager">
    <div class="container-fluid">
        <article class="esh-pager-wrapper row">
            <nav class="w-100 d-flex">
                <div class="col-md-2 col-12">
                    <a class="esh-pager-item-left esh-pager-item--navigable esh-pager-item @(HasPrevious ? "" : "is-disabled")"
                       href="" @onclick="() => Go(PageIndex - 1)" @onclick:preventDefault aria-label="Previous">
                        Previous
                    </a>
                </div>
                <div class="col-md-8 col-12">
                    <span class="esh-pager-item">Page @(PageIndex + 1) - @PageCount</span>
                </div>
                <div class="col-md-2 col-12">
                    <a class="esh-pager-item-right esh-pager-item--navigable esh-pager-item @(HasNext ? "" : "is-disabled")"
                       href="" @onclick="() => Go(PageIndex + 1)" @onclick:preventDefault aria-label="Next">
                        Next
                    </a>
                </div>
            </nav>
        </article>
    </div>
</div>

@code {
    [Parameter] public int PageIndex { get; set; }
    [Parameter] public int PageCount { get; set; }
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }

    private bool HasPrevious => PageIndex > 0;
    private bool HasNext => PageIndex < PageCount - 1;

    private async Task Go(int index)
    {
        if (index >= 0 && index < PageCount) await OnPageChanged.InvokeAsync(index);
    }
}
