@implements IDisposable
@inject BasketState BasketState

<a class="esh-basketstatus" href="basket">
    <div class="esh-basketstatus-image">
        <img src="images/cart.png" />
    </div>
    <div class="esh-basketstatus-badge">
        @BasketState.ItemCount
    </div>
</a>

@code {
    protected override async Task OnInitializedAsync()
    {
        BasketState.OnChange += StateHasChanged;
        await BasketState.RefreshAsync();
    }

    public void Dispose() => BasketState.OnChange -= StateHasChanged;
}
