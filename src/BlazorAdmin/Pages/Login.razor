@page "/login"
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>eShopOnWeb Admin: Log in</PageTitle>

<h1>Log in</h1>

<EditForm Model="model" OnValidSubmit="Submit">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" />
    @if (error != null)
    {
        <div class="text-danger">@error</div>
    }
    <div class="form-group">
        <label for="email">Email</label>
        <InputText id="email" class="form-control" @bind-Value="model.Email" />
    </div>
    <div class="form-group">
        <label for="password">Password</label>
        <InputText id="password" type="password" class="form-control" @bind-Value="model.Password" />
    </div>
    <button type="submit" class="btn btn-primary" disabled="@submitting">Log in</button>
    <p class="mt-3">Demo admin: <b>admin@microsoft.com</b> / <b>Pass@word1</b></p>
</EditForm>

@code {
    [SupplyParameterFromQuery] public string ReturnUrl { get; set; }

    private readonly LoginModel model = new();
    private string error;
    private bool submitting;

    private async Task Submit()
    {
        submitting = true;
        error = await AuthStateProvider.LoginAsync(model.Email, model.Password);
        submitting = false;

        if (error == null)
        {
            // Only allow local paths, so the login page can't be used as an open redirect.
            var target = !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith("/") && !ReturnUrl.StartsWith("//") ? ReturnUrl : "/";
            Navigation.NavigateTo(target);
        }
    }

    private class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; }

        [System.ComponentModel.DataAnnotations.Required]
        public string Password { get; set; }
    }
}
