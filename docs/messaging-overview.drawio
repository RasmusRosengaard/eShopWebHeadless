                <mxCell id="tbl-topology" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;overflow=fill;" value="&lt;b&gt;Exchanges og queues&lt;/b&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; style=&quot;border-collapse:collapse;font-size:11px;margin-top:4px;width:100%&quot;&gt;&lt;tr style=&quot;background:#f8cecc&quot;&gt;&lt;th align=&quot;left&quot;&gt;Navn&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;Type&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;Egenskaber&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;Deklareres af&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;Bindings&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;exchange &lt;code&gt;catalog&lt;/code&gt;&lt;/td&gt;&lt;td&gt;topic&lt;/td&gt;&lt;td&gt;durable&lt;/td&gt;&lt;td&gt;CatalogService + monolitten (samme deklaration, idempotent)&lt;/td&gt;&lt;td&gt;→ &lt;code&gt;monolith.catalog&lt;/code&gt; med &lt;code&gt;catalog.item.*&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;exchange &lt;code&gt;&quot;&quot;&lt;/code&gt; (default)&lt;/td&gt;&lt;td&gt;direct&lt;/td&gt;&lt;td&gt;indbygget, kan ikke slettes eller bindes manuelt&lt;/td&gt;&lt;td&gt;RabbitMQ&lt;/td&gt;&lt;td&gt;→ hver kø, binding key = kønavn&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;queue &lt;code&gt;monolith.catalog&lt;/code&gt;&lt;/td&gt;&lt;td&gt;classic&lt;/td&gt;&lt;td&gt;durable · ikke exclusive · ikke auto-delete&lt;/td&gt;&lt;td&gt;monolitten&lt;/td&gt;&lt;td&gt;&lt;code&gt;catalog.item.*&lt;/code&gt; fra &lt;code&gt;catalog&lt;/code&gt; (+ implicit fra default)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;queue &lt;code&gt;monolith.catalog.invalid&lt;/code&gt;&lt;/td&gt;&lt;td&gt;classic&lt;/td&gt;&lt;td&gt;durable · ikke exclusive · ikke auto-delete&lt;/td&gt;&lt;td&gt;monolitten + InvalidMessageConsumer&lt;/td&gt;&lt;td&gt;kun implicit fra default&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
